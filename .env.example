# Copy to .env and fill in your own values. .env is gitignored.
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./support_agent.db
REDIS_URL=

# --- LLM (OpenAI-compatible) ---
# All three must be set to enable the real model, otherwise /chat uses the local rule model.
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com    LLM_MODEL=deepseek-v4-flash
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

EMBEDDING_MODEL=

# --- Tunables ---
AGENT_MAX_ROUNDS=5
CHAT_HISTORY_LIMIT=10
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0

CONFIRMATION_SECRET=replace-this-before-deployment
MAX_UPLOAD_BYTES=5242880
